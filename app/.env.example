# --- Client-side (exposed to the browser) ---
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-nhost-subdomain
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# --- Server-side (used only by the /pages/api routes) ---
DATABASE_URL=postgres://user:pass@host:5432/dbname
ACTION_SECRET=choose-a-long-random-string-and-put-same-value-in-hasura-env
GROQ_API_KEY=
